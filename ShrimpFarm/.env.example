# Django
SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Production — Render sets DATABASE_URL; do not use SQLite on the host
# DATABASE_URL=postgres://user:pass@host:5432/dbname
# DEBUG=False
# ALLOWED_HOSTS=.onrender.com
# FRONTEND_URL=https://YOUR-SERVICE.onrender.com
DB_NAME=minhdungfarm
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# JWT (minutes)
JWT_ACCESS_TOKEN_LIFETIME=480

# CORS — Vite dev server
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend URL (used in password-reset email links)
FRONTEND_URL=http://localhost:5173

# HiveMQ Cloud (MQTT TLS 8883 for Python bridge; ESP32 uses WSS 8884)
MQTT_HOST=06a79f0e02dd47a79baef7b9fcabdb10.s1.eu.hivemq.cloud
MQTT_PORT=8883
MQTT_USER=
MQTT_PASSWORD=
MQTT_TOPIC=shrimpfarm/sensor/temperature
MQTT_CLIENT_ID=django-shrimp-bridge
MQTT_DEFAULT_POND_ID=1

# Email (forgot-password). Leave EMAIL_HOST empty for console backend.
# Gmail: use an App Password, not your Google login password
# (Google Account → Security → 2-Step Verification → App passwords).
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
