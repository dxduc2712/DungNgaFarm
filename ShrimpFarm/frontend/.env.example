VITE_API_BASE_URL=http://localhost:8000
VITE_DJANGO_ADMIN_PATH=/django-admin/

# Production (Vite PROD build): leave VITE_API_BASE_URL empty so the SPA
# calls /api/v1 on the same origin as Django.

# Note: password-reset emails use backend FRONTEND_URL (see ShrimpFarm/.env.example)
# so reset links point at this Vite app (e.g. http://localhost:5173/reset-password/...).

